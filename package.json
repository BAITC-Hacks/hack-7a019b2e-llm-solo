{
  "name": "llm-solo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/run-python.mjs -m moneygraph --serve",
    "analyze": "node scripts/run-python.mjs -m moneygraph",
    "llm:demo": "node --env-file-if-exists=.env src/cli.js",
    "test": "node --test",
    "test:graph": "node scripts/run-python.mjs -m unittest discover -s tests -v",
    "check": "node --check src/cli.js && node --test"
  }
}
